# ---------------------------------------------------------------------------
# Exchange Rate POC – backend configuration
# Copy this file to backend/.env and adjust as needed. All values are optional;
# the defaults shown here are used when a variable is missing.
# ---------------------------------------------------------------------------

# HTTP port for the Express API
PORT=4000

# Origin allowed to call the API from a browser (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Company/ERP currency that rates are expressed in (1 unit of foreign currency = X TARGET)
TARGET_CURRENCY=AED

# Currencies shown by default on the dashboard
DEFAULT_CURRENCIES=USD,EUR,GBP,INR,SAR,CNY

# Provider selection. Available ids: open-er-api, currency-api
# PRIMARY_PROVIDER is tried first; FALLBACK_PROVIDER (optional, blank to disable)
# is used only if the primary fails.
PRIMARY_PROVIDER=open-er-api
FALLBACK_PROVIDER=currency-api

# Provider base URLs (override only if the provider changes its endpoint)
OPEN_ER_API_BASE_URL=https://open.er-api.com/v6
CURRENCY_API_BASE_URL=https://cdn.jsdelivr.net/npm/@fawazahmed0/currency-api

# Commercial provider placeholder – NOT used by the POC yet. Keep keys server-side only.
# OPEN_EXCHANGE_RATES_APP_ID=

# Upstream HTTP timeout in milliseconds
REQUEST_TIMEOUT_MS=8000

# How long a successful response is reused before calling the provider again
CACHE_TTL_SECONDS=600

# "Fetch Latest Rates" will not call the provider more often than this
# (protects free-tier rate limits)
MIN_REFRESH_INTERVAL_SECONDS=60

# Rates older than this are flagged as stale, even with no missing business days
STALE_AFTER_HOURS=48

# Days on which reference rates are typically not published (0=Sun ... 6=Sat).
# UAE weekend is Saturday/Sunday.
WEEKEND_DAYS=0,6

# Public holidays (YYYY-MM-DD, comma separated) used to explain publication gaps
HOLIDAYS=2026-12-02,2026-12-03

# Decimal places stored for FCY->AED rates (ERP column suggested: DECIMAL(19,8))
RATE_DECIMAL_PLACES=8

# ERP preview: a new rate that moves more than this % vs the last issued rate
# is held for manual approval even in Automatic Mode
MAX_DEVIATION_PERCENT=5

# Foreign currencies shown in the ERP (Zybo) branch exchange-rate tables - the same list as Zybo's
# Branches Exchange Rate screen (its non-ISO "YEN" row is the same currency as JPY), plus AED.
# Each country's own base currency is left out automatically. Independent of the overview selection.
ERP_CURRENCIES=AED,AUD,BHD,BND,CHF,CNY,DKK,EUR,GBP,HKD,IDR,INR,JPY,KWD,MAD,NOK,NZD,OMR,QAR,SAR,SEK,SGD,THB,USD,ZAR

# --- Daily automatic update (in-app scheduler, POC) ---------------------------
# Every day at DAILY_FETCH_TIME (24-hour, in DAILY_FETCH_TIMEZONE) the server fetches
# fresh rates and proposes them for all ERP countries. Nothing is written to Zybo.
# Runs only while this server is running; if it starts after the time and today's
# run hasn't happened, it runs immediately.
DAILY_FETCH_ENABLED=true
DAILY_FETCH_TIME=08:00
DAILY_FETCH_TIMEZONE=Asia/Dubai
# If the provider is down: retry every N minutes, up to M attempts, then give up for the day
DAILY_FETCH_RETRY_MINUTES=15
DAILY_FETCH_MAX_ATTEMPTS=8
# Which rate providers the automatic update applies (comma separated): exchangerate-api, currencyapi-com, oanda.
# Each provider keeps its own effective rates and overrides. Providers without an API key are skipped.
# currencyapi.com uses about 2 requests per day (latest + previous day), well inside its free 300/month.
DAILY_FETCH_PROVIDERS=exchangerate-api,currencyapi-com,oanda

# --- Rate editor (the ONE user allowed to edit rates) --------------------------
# Rates are read-only for everyone else. The passcode stays on this server; signing in returns a
# session token that every edit request must carry (checked by the backend, not just the UI).
# Leave ERP_EDITOR_PASSCODE empty to turn manual editing off. Production would use Entra ID instead.
ERP_EDITOR_NAME=Finance Manager
ERP_EDITOR_PASSCODE=

# --- currencyapi.com (second provider, for comparison) ------------------------
# Get a key at https://app.currencyapi.com. The key is used ONLY by this backend, sent as
# the "apikey" request header. It is never sent to the browser - do NOT put it in
# frontend/.env or any VITE_* variable. Leave empty to show the provider as "Key needed".
CURRENCYAPI_COM_API_KEY=
CURRENCYAPI_COM_BASE_URL=https://api.currencyapi.com/v3
# The free plan allows 300 requests/month, so cache longer than the free provider.
# One AED snapshot serves every target and country (other bases are cross-calculated).
CURRENCYAPI_COM_CACHE_TTL_SECONDS=14400
# "Fetch Latest" will not call currencyapi.com more often than this.
CURRENCYAPI_COM_MIN_REFRESH_INTERVAL_SECONDS=900

# --- OANDA Exchange Rates API (third provider) --------------------------------
# Business and financial FX data (NOT the OANDA forex-trading API). A trial or paid subscription is required:
# see the README, "Getting an OANDA API key". The key is used ONLY by this backend, sent as an Authorization
# header. Never put it in frontend/.env or any VITE_* variable. Leave empty to show OANDA as "Key needed".
OANDA_API_KEY=
OANDA_BASE_URL=https://www.oanda.com/rates/api/v1
# Rate type the ERP and the daily update use: midpoint (default), bid or ask. The dashboard can preview the others.
OANDA_RATE_TYPE=midpoint
# Quote currencies requested per call (OANDA bills per quote). Empty = ERP_CURRENCIES + DEFAULT_CURRENCIES + AED.
# Use "all" for every currency (uses much more quota).
OANDA_QUOTE_CURRENCIES=
OANDA_CACHE_TTL_SECONDS=14400
OANDA_MIN_REFRESH_INTERVAL_SECONDS=900
# Longest history chart for OANDA in days (each day is one request). 0 turns it off.
OANDA_HISTORY_MAX_DAYS=7
# Only if a company firewall re-signs HTTPS traffic (error UNABLE_TO_VERIFY_LEAF_SIGNATURE): path to the
# firewall's CA certificate (PEM). It is trusted for OANDA only; certificate checking stays on.
# Example: OANDA_CA_CERT_FILE=C:\certs\firewall-ca.pem
OANDA_CA_CERT_FILE=

# --- Compare All Providers ----------------------------------------------------------------
# |difference| <= ALIGNED -> "Aligned"; <= REVIEW -> "Minor difference"; above -> "Large difference"
COMPARE_ALIGNED_PERCENT=0.5
COMPARE_REVIEW_PERCENT=2
